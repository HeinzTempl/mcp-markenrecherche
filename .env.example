# EUIPO Developer Portal – "Key" im Portal = Client-ID
# App im Produktivportal (https://dev.euipo.europa.eu)
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
# App im Sandbox-Portal (https://dev-sandbox.euipo.europa.eu), optional
EUIPO_SANDBOX_CLIENT_ID=
EUIPO_SANDBOX_CLIENT_SECRET=
# production | sandbox
EUIPO_ENV=production
